{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mm02:packages:v1",
  "$comment": "Also enforce unique file IDs, exactly one title with null index, contiguous chapter indices, and all signed license bindings using original payload bytes.",
  "oneOf": [
    {
      "$ref": "#/$defs/content"
    },
    {
      "$ref": "#/$defs/license"
    },
    {
      "$ref": "#/$defs/firmware"
    }
  ],
  "$defs": {
    "content": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "content"
        },
        "content_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "language": {
          "const": "hu"
        },
        "codec": {
          "const": "mp3"
        },
        "sample_rate_hz": {
          "const": 32000
        },
        "bitrate_kbps": {
          "const": 64
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "role": {
                "enum": [
                  "title",
                  "chapter"
                ]
              },
              "chapter_index": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483648
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file_id",
              "role",
              "chapter_index",
              "size_bytes",
              "sha256",
              "duration_ms"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 32
        }
      },
      "required": [
        "v",
        "kind",
        "content_id",
        "version",
        "title",
        "language",
        "codec",
        "sample_rate_hz",
        "bitrate_kbps",
        "files"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "license"
        },
        "device_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "content_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "kind",
        "device_id",
        "content_id",
        "content_version",
        "manifest_sha256",
        "grant_id",
        "issued_at"
      ],
      "additionalProperties": false
    },
    "firmware": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "firmware"
        },
        "hardware_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "secure_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "min_protocol": {
          "const": 2
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483648
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "size_bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "v",
        "kind",
        "hardware_id",
        "version",
        "secure_version",
        "min_protocol",
        "files"
      ],
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "properties": {
        "alg": {
          "const": "RS256"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "typ": {
          "enum": [
            "MM02-MANIFEST",
            "MM02-LICENSE",
            "MM02-FIRMWARE"
          ]
        }
      },
      "required": [
        "alg",
        "kid",
        "typ"
      ],
      "additionalProperties": false
    }
  }
}
