[Unit]
Description=Mesemondo dedicated PostgreSQL (private Unix socket)
After=local-fs.target

[Service]
Type=simple
User=mesemondo-db
Group=mesemondo
RuntimeDirectory=mesemondo-postgresql
RuntimeDirectoryMode=0750
ExecStart=/opt/mesemondo-tools/postgresql-16/bin/postgres -D /var/lib/mesemondo/postgres
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=30%
MemoryHigh=96M
MemoryMax=160M
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mesemondo/postgres /run/mesemondo-postgresql
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
